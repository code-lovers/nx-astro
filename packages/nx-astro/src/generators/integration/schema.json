{
  "$schema": "https://json-schema.org/schema",
  "$id": "NxAstroIntegration",
  "title": "Astro integration",
  "description": "Runs `astro add` in the folder of an Astro project.",
  "type": "object",
  "properties": {
    "project": {
      "type": "string",
      "description": "The name of the Astro project.",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "Which Astro project do you want to add integrations to?",
      "x-dropdown": "projects",
      "x-priority": "important"
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The Astro integrations that `astro add` adds, for example react or mdx.",
      "x-prompt": {
        "message": "Which Astro integrations do you want to add?",
        "type": "list",
        "multiselect": true,
        "items": [
          {
            "value": "react",
            "label": "React"
          },
          {
            "value": "preact",
            "label": "Preact"
          },
          {
            "value": "vue",
            "label": "Vue"
          },
          {
            "value": "svelte",
            "label": "Svelte"
          },
          {
            "value": "solid-js",
            "label": "Solid"
          },
          {
            "value": "lit",
            "label": "Lit"
          },
          {
            "value": "alpinejs",
            "label": "Alpine.js"
          },
          {
            "value": "starlight",
            "label": "Starlight (docs)"
          },
          {
            "value": "netlify",
            "label": "Netlify adapter"
          },
          {
            "value": "vercel",
            "label": "Vercel adapter"
          },
          {
            "value": "deno",
            "label": "Deno adapter"
          },
          {
            "value": "cloudflare",
            "label": "Cloudflare adapter"
          },
          {
            "value": "node",
            "label": "Node adapter"
          },
          {
            "value": "tailwind",
            "label": "Tailwind CSS"
          },
          {
            "value": "mdx",
            "label": "MDX"
          },
          {
            "value": "markdoc",
            "label": "Markdoc"
          },
          {
            "value": "partytown",
            "label": "Partytown"
          },
          {
            "value": "sitemap",
            "label": "Sitemap"
          }
        ]
      }
    }
  },
  "required": ["project", "integrations"]
}
