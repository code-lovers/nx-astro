{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tools/scripts/*.ts"]
    },
    "packages/nx-astro": {
      "entry": ["src/generators/*/*.ts", "!src/generators/*/*.spec.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/nx-astro-e2e": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreDependencies": [
    "@astrojs/check",
    "@eslint/js",
    "@nx/plugin",
    "astro",
    "typescript-eslint"
  ],
  "ignoreUnresolved": ["^\\*$"],
  "ignoreIssues": {
    "packages/nx-astro/src/generators/*/*.ts": ["duplicates"]
  }
}
